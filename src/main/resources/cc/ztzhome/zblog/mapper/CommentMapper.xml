<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cc.ztzhome.zblog.mapper.CommentMapper">

    <resultMap id="CommentResultMap" type="cc.ztzhome.zblog.bean.entity.Comment">
        <id property="commentId" column="comment_id" />
        <result property="articleId" column="article_id" />
        <result property="userId" column="user_id" />
        <result property="parentId" column="parent_id" />
        <result property="replyToUserId" column="reply_to_user_id" />
        <result property="content" column="content" />
        <result property="createTime" column="create_time" />
    </resultMap>

    <insert id="insert" parameterType="cc.ztzhome.zblog.bean.entity.Comment"
            useGeneratedKeys="true" keyProperty="commentId">
        INSERT INTO tb_blog_comment (article_id, user_id, parent_id, reply_to_user_id, content, create_time)
        VALUES (#{articleId}, #{userId}, #{parentId}, #{replyToUserId}, #{content}, #{createTime})
    </insert>

    <delete id="deleteById">
        DELETE FROM tb_blog_comment WHERE comment_id = #{commentId}
    </delete>

    <delete id="deleteByParentId">
        DELETE FROM tb_blog_comment WHERE parent_id = #{parentId}
    </delete>

    <select id="selectById" resultMap="CommentResultMap">
        SELECT * FROM tb_blog_comment WHERE comment_id = #{commentId}
    </select>

    <select id="selectByArticleId" resultMap="CommentResultMap">
        SELECT * FROM tb_blog_comment
        WHERE article_id = #{articleId}
        ORDER BY create_time ASC
    </select>

    <select id="countByArticleId" resultType="int">
        SELECT COUNT(*) FROM tb_blog_comment WHERE article_id = #{articleId}
    </select>

</mapper>
